# Backend
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Isi hanya jika backend berada di belakang reverse proxy tepercaya.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m
LOG_LEVEL=info
# Kosong berarti export OTLP dimatikan. `make observability` mengisi nilai ini.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=boilerplate-api
OTEL_TRACES_SAMPLER_ARG=1.0
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_BODY_BYTES=1048576

# Frontend, dibaca saat build. Path relatif berarti same-origin.
VITE_API_URL=/api/v1
